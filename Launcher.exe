        ["Учёный", "s_m_m_scientist_01"], ["Шериф (М)", "s_m_y_sheriff_01"], ["Шериф (Ж)", "s_f_y_sheriff_01"]
    ]
    PLV := PM.Add("ListView", "r12 w380 Grid", ["Роль актера", "Код модели"])
    PLV.ModifyCol(1, 230)
    PLV.ModifyCol(2, 120)
    For p in PL
        PLV.Add(, p[1], p[2])
    PM.Add("Button", "w380 Default", "Выдать скин").OnEvent("Click", (*) => (
        R := PLV.GetNext(),
        R ? (Model := PLV.GetText(R, 2), PM.Destroy(), SetTimer(() => SendGameCmd("/setmodel " TargetID " " Model), -200)) : 0
    ))
    PM.Show()
}

; =============================================================================
; ПРАВИЛА RMRP
; =============================================================================
pp_text := "
(
════════ ПРАВИЛА ПРОЕКТА RMRP ════════

1. ОБЩИЕ ПОЛОЖЕНИЯ
1.1. Регистрируясь на проекте RMRP, вы автоматически соглашаетесь с настоящими правилами и обязуетесь их соблюдать.
1.2. Игровой никнейм персонажа должен быть оформлен в формате «Имя Фамилия» с заглавной буквы. Цифры, символы, латиница, нецензурная лексика в нике запрещены.
1.3. Администрация вправе изменять правила без предварительного уведомления. Актуальная версия всегда на форуме.
1.4. Незнание правил не освобождает от ответственности.
1.5. Правила действуют как в игре, так и в официальных Discord/Telegram-каналах проекта.

2. ТЕРМИНЫ
2.1. IC (In Character) — всё, что происходит от лица персонажа в игровом мире.
2.2. OOC (Out of Character) — общение вне роли, о реальном мире.
2.3. RP (Roleplay) — отыгрывание роли персонажа.
2.4. DM (DeathMatch) — убийство или урон без отыгровки и веской IC-причины.
2.5. RK (Revenge Kill) — месть после возрождения.
2.6. MG (MetaGaming) — использование OOC-информации в IC-процессе.
2.7. PG (PowerGaming) — навязывание действий, которые персонаж физически совершить не мог.
2.8. SK (Spawn Kill) — убийство в зоне спавна.
2.9. TK (Team Kill) — урон союзнику.
2.10. BugUse — использование багов сервера или игровых механик для получения преимущества.
2.11. Abuse — злоупотребление правами/возможностями.

3. ЗАПРЕЩЕНО
3.1. Читы, автокликеры (кроме разрешённого анти-АФК), сторонние модификации клиента, программы обхода защиты.
3.2. Любые формы DM, RK, MG, PG, SK, TK.
3.3. Массовый DM (Mass DM). Терроризм — только с разрешения администрации.
3.4. Оскорбления в IC/OOC, разжигание межнациональной розни, расизм, нацизм, экстремизм.
3.5. Реклама сторонних проектов, серверов, ресурсов.
3.6. Мошенничество с игровыми ценностями, обман на реальные деньги.
3.7. Нецензурная лексика в глобальных чатах.
3.8. Флуд, спам, капс в любых чатах.
3.9. Попрошайничество у администрации и игроков.
3.10. Нахождение на территории военных объектов без RP-причины.
3.11. Нарушение правил во время мероприятий и ивентов.
3.12. Уход от наказания, создание твинков после бана.

4. ЧАТЫ И ОБЩЕНИЕ
4.1. /ooc — глобальный чат вне роли.
4.2. Локальный чат — для IC-общения.
4.3. Голосовой чат — только IC, в игровом мире.
4.4. Discord/Telegram допустимы, но не для MG.
4.5. Запрещено выдавать себя за администрацию в любых чатах.

5. ОТВЕТСТВЕННОСТЬ
5.1. Меры: предупреждение, мут, кик, бан 1–30 дней, перманентный бан.
5.2. Мера наказания — на усмотрение администрации.
5.3. Обжалование — только через форум.
5.4. Читы и баг-абуз — перманентный бан без амнистии.

6. ДОНАТ И ЦЕННОСТИ
6.1. Донат не даёт права нарушать правила.
6.2. Операции с игровыми ценностями — на ваш риск.
6.3. Возврат доната — только по правилам платёжной системы.

7. АККАУНТ
7.1. Передача аккаунта третьим лицам запрещена.
7.2. Администрация не возвращает имущество, утраченное при передаче аккаунта.
7.3. Мультиаккаунт допустим, если не противоречит другим правилам.
)"

pgo_text := "
(
════ ПРАВИЛА ГОСУДАРСТВЕННЫХ ОРГАНИЗАЦИЙ RMRP ════

1. ОБЩИЕ ПОЛОЖЕНИЯ
1.1. Сотрудниками государственных организаций (ПГО) являются члены фракций: МВД, ФСБ, Прокуратура, Суд, Администрация Президента, Больница, СМИ.
1.2. Все сотрудники обязаны подчиняться внутреннему уставу своей организации и иерархии.
1.3. Сотрудник ПГО не имеет права разглашать внутреннюю информацию структуры третьим лицам (кроме случаев, предусмотренных законом).

2. ПОВЕДЕНИЕ
2.1. Сотрудник ПГО обязан вести себя сдержанно, соблюдать субординацию, обращаться к гражданам на «Вы».
2.2. Запрещено использование нецензурной лексики в IC-общении при исполнении.
2.3. Запрещено появляться на службе в состоянии опьянения (IC).
2.4. Запрещено оставлять службу без уважительной причины.

3. КОРРУПЦИЯ
3.1. Коррупция (взятки, крышевание, продажа званий, сведений) запрещена и карается увольнением + ЧС организации.
3.2. Мелкие нарушения (опоздания, халатность) — выговор/понижение.
3.3. Тяжкие нарушения (коррупция, применение оружия без оснований) — увольнение + ЧС + при необходимости бан.

4. ПРИМЕНЕНИЕ ОРУЖИЯ
4.1. Огнестрельное оружие применяется только при непосредственной угрозе жизни и здоровью.
4.2. Запрещено стрелять по безоружным гражданам без веских оснований.
4.3. Запрещено использовать служебное оружие в личных целях.
4.4. Перед применением оружия обязательны предупредительные выстрелы (если позволяет ситуация).

5. ЗАДЕРЖАНИЕ И АРЕСТ
5.1. Задержание производится только при наличии состава правонарушения.
5.2. Задержанному обязаны зачитать права (правило Миранды).
5.3. Обыск проводится только в присутствии понятых или под видеозапись.
5.4. Арест оформляется протоколом, копия — задержанному.
5.5. Срок задержания без предъявления обвинения — не более 3 часов IC.

6. ОБЩЕНИЕ С ГРАЖДАНАМИ
6.1. Сотрудник ПГО обязан представиться (звание, ФИО, отдел).
6.2. Запрещено унижать и оскорблять граждан.
6.3. Запрещено игнорировать обращения граждан, если сотрудник свободен.

7. ВЗАИМОДЕЙСТВИЕ МЕЖДУ ОРГАНИЗАЦИЯМИ
7.1. Старший по званию координирует действия на месте.
7.2. Споры между структурами решаются через руководство.
7.3. Самовольное вмешательство в дела другой структуры запрещено.

8. ОТВЕТСТВЕННОСТЬ
8.1. Выговор, понижение, увольнение, ЧС организации — по тяжести нарушения.
8.2. При грубых нарушениях — бан аккаунта.
8.3. Нарушения ПГО рассматриваются руководством организации и куратором от администрации.
)"

pko_text := "
(
════ ПРАВИЛА КРИМИНАЛЬНЫХ ОРГАНИЗАЦИЙ RMRP ════

1. ОБЩИЕ ПОЛОЖЕНИЯ
1.1. Криминальными организациями (ПКО) являются: мафии (русская, итальянская, мексиканская, японская), банды (Ballas, Families, Vagos, Grove), картель, байкеры, отдельные ОПГ.
1.2. Каждая ОПГ имеет свой район и сферу влияния.
1.3. Члены ОПГ обязаны подчиняться внутренней иерархии.

2. ЗАПРЕЩЕНО
2.1. Запрещается угон авто в районах: Исторический, Деловой, Правительственный, а также у ПГО.
2.2. Запрещены нападения на государственные структуры без согласования с администрацией.
2.3. Запрещены ограбления больниц, школ, детских садов.
2.4. Запрещены убийства сотрудников ПГО на территории их организаций без RP-причины.
2.5. Запрещены похищения сотрудников администрации и разработчиков.

3. ОГРАБЛЕНИЯ
3.1. Ограбление магазина — обязательна RP-подготовка (маска, оружие, крик «Это ограбление!»).
3.2. Ограбление банка — только по предварительному согласованию с администрацией, минимум 3 участника со стороны ОПГ.
3.3. Ограбление инкассаторов — разрешено, но с обязательным отыгрышем.
3.4. Запрещено ограбление одного и того же объекта чаще 1 раза в час.
3.5. После ограбления обязательна отыгровка отхода (нельзя испаряться).

4. ПОХИЩЕНИЯ
4.1. Похищение гражданина — минимум 2 участника, RP-причина.
4.2. Похищение сотрудника ПГО — минимум 3 участника, предварительный отыгрыш.
4.3. Похищение сотрудника администрации — запрещено.
4.4. Максимальный срок похищения — 30 минут IC.
4.5. Запрещено похищение с целью MG (получение OOC-инфо).

5. ВОЙНЫ И РАЗБОРКИ
5.1. Война между ОПГ начинается с официального объявления на форуме/в Discord.
5.2. До объявления войны запрещено массовое убийство членов другой ОПГ.
5.3. Разборки — только на нейтральной территории или территории одной из сторон.
5.4. Запрещено использование транспорта для тарана без предварительной отыгровки.
5.5. Захват чужой территории — только с разрешения администрации.

6. ТЕРРИТОРИИ
6.1. Каждая ОПГ имеет основной и дополнительные районы.
6.2. Заходить на территорию чужой ОПГ можно, но с IC-причиной.
6.3. Крышевание бизнеса — только в своём районе.

7. ОРУЖИЕ И ЭКИПИРОВКА
7.1. Ношение оружия в людных местах — повод для IC-внимания ПГО.
7.2. Тяжёлое оружие (автоматы, снайперки) — только на войнах и ограблениях.
7.3. Запрещено носить оружие при себе в мирных зонах (больницы, мэрия, суд).

8. ОТВЕТСТВЕННОСТЬ
8.1. За нарушение правил ПКО — предупреждение, штраф, кик, бан.
8.2. За массовые нарушения — роспуск ОПГ.
8.3. За использование читов — перманентный бан всех участников.
)"

fkz_text := "
(
══ ФЕДЕРАЛЬНЫЙ КОНСТИТУЦИОННЫЙ ЗАКОН RMRP ══

ГЛАВА I. ОБЩИЕ ПОЛОЖЕНИЯ

Статья 1. Источник власти
1.1. Единственным источником власти в штате является народ.
1.2. Народ осуществляет власть через выборы и референдумы.
1.3. Высшим должностным лицом является Президент штата.

Статья 2. Территория
2.1. Территория штата неделима и неприкосновенна.
2.2. Штат состоит из районов, управляемых местными администрациями.

Статья 3. Законодательство
3.1. Законы штата принимаются Парламентом.
3.2. Законы не должны противоречить настоящему ФКЗ.
3.3. Законы вступают в силу после подписания Президентом.

ГЛАВА II. ИСПОЛНИТЕЛЬНАЯ ВЛАСТЬ

Статья 4. Президент
4.1. Президент избирается всеобщим голосованием на 30 IC-дней.
4.2. Президент формирует Правительство.
4.3. Президент имеет право вето на законы Парламента.
4.4. Президент может быть отрешён от должности за измену и тяжкие преступления.

Статья 5. Правительство
5.1. Правительство состоит из министров.
5.2. Министры назначаются Президентом и подотчётны ему.
5.3. Правительство обеспечивает исполнение законов.

Статья 6. Силовые структуры
6.1. МВД, ФСБ, Прокуратура подчиняются Президенту и Правительству.
6.2. Применение силы допускается только в рамках закона.

ГЛАВА III. ЗАКОНОДАТЕЛЬНАЯ ВЛАСТЬ

Статья 7. Парламент
7.1. Парламент состоит из депутатов, избираемых народом.
7.2. Парламент принимает законы большинством голосов.
7.3. Депутат не может занимать должность в Правительстве.

Статья 8. Законотворческий процесс
8.1. Законопроект вносится депутатом или Президентом.
8.2. После принятия Парламентом закон передаётся Президенту.
8.3. Президент подписывает или отклоняет закон в течение 3 IC-дней.

ГЛАВА IV. СУДЕБНАЯ ВЛАСТЬ

Статья 9. Суд
9.1. Правосудие осуществляется только судом.
9.2. Судьи независимы и подчиняются только ФКЗ и законам штата.
9.3. Решения суда обязательны для всех.

Статья 10. Прокуратура
10.1. Прокуратура осуществляет надзор за соблюдением законов.
10.2. Прокурор вправе возбуждать уголовные дела.
10.3. Прокуратура независима от Правительства.

ГЛАВА V. ПРАВА И СВОБОДЫ

Статья 11. Основные права
11.1. Все граждане равны перед законом.
11.2. Каждый имеет право на жизнь, свободу, собственность.
11.3. Каждый имеет право на защиту в суде.
11.4. Запрещены пытки, унижающее достоинство обращение, рабство.

Статья 12. Ограничения
12.1. Права могут быть ограничены только законом и только в целях защиты прав других лиц.
12.2. Ограничение прав допускается при чрезвычайном положении.

ГЛАВА VI. ПОПРАВКИ

Статья 13. Внесение поправок
13.1. Поправки вносятся Парламентом или Президентом.
13.2. Поправка принимается 2/3 голосов Парламента.
13.3. Поправка вступает в силу после подписания Президентом.
)"

; =============================================================================
; ГОРЯЧИЕ КЛАВИШИ ХЕЛПЕРКИ
; =============================================================================
#HotIf ScriptState["Helpers"]

!Up:: {
    Global TargetPlayerID, CurrentSkinIndex, IsActiveTest, IsSkinEvaluated, PedsTestResults
    RawID := InputBox("Введите 6 цифр ID актера для теста скинов:", "Запуск внутриигрового теста").Value
    if (RawID == "" or !(RawID ~= "^\d{6}$")) {
        MsgBox("Неверный ID!", "Ошибка")
        return
    }
    TargetPlayerID := SubStr(RawID, 1, 3) "-" SubStr(RawID, 4, 3)
    CurrentSkinIndex := 1
    IsActiveTest := 1
    IsSkinEvaluated := 0
    PedsTestResults := "=== ЛОГ ТЕСТИРОВАНИЯ СКИНОВ RMRP ===`n`n"
    HudText.Value := "Скин [" CurrentSkinIndex "/" PedsBase.Length "]: " PedsBase[CurrentSkinIndex] "`n🟡 Ожидание оценки...`n[Alt+Влево: Рабочий | Alt+Вправо: Нерабочий]"
    TestGui.Show("x50 y150 NoActivate")
    SetTimer(() => SendSkinToGame(), -100)
}

!Left::  (IsActiveTest ? SaveSkinResult("РАБОЧИЙ") : 0)
!Right:: (IsActiveTest ? SaveSkinResult("НЕРАБОЧИЙ") : 0)

!Down:: {
    Global IsActiveTest, IsSkinEvaluated, CurrentSkinIndex, PedsTestResults
    if (!IsActiveTest)
        return
    if (!IsSkinEvaluated) {
        HudText.Value := "Скин [" CurrentSkinIndex "/" PedsBase.Length "]: " PedsBase[CurrentSkinIndex] "`n❌ Сначала выберите статус! [Alt+Влево / Alt+Вправо]"
        return
    }
    if (CurrentSkinIndex >= PedsBase.Length) {
        IsActiveTest := 0
        TestGui.Hide()
        A_Clipboard := PedsTestResults
        MsgBox("Все скины протестированы! Результаты скопированы в буфер обмена (Ctrl+V).", "Готово")
        return
    }
    CurrentSkinIndex += 1
    IsSkinEvaluated := 0
    HudText.Value := "Скин [" CurrentSkinIndex "/" PedsBase.Length "]: " PedsBase[CurrentSkinIndex] "`n🟡 Ожидание оценки...`n[Alt+Влево: Рабочий | Alt+Вправо: Нерабочий]"
    SendSkinToGame()
}

F10:: {
    static TextGui := 0
    if !IsObject(TextGui) || !TextGui.Visible {
        TextGui := Gui("+AlwaysOnTop +ToolWindow", "Просмотр буфера")
        TextGui.SetFont("s10", "Segoe UI")
        TextGui.Add("Edit", "r20 w600 Multi +Wrap +VScroll", A_Clipboard)
        TextGui.Add("Button", "w100 Default", "Закрыть").OnEvent("Click", (*) => TextGui.Destroy())
        TextGui.Show()
    } else {
        TextGui.Destroy()
    }
}

^!c:: {
    NvidiaFolder := EnvGet("USERPROFILE") "\Videos\NVIDIA"
    if !DirExist(NvidiaFolder) {
        MsgBox("Папка NVIDIA не найдена: " NvidiaFolder, "Ошибка", "Icon! T3")
        return
    }
    DeletedCount := 0
    Loop Files NvidiaFolder "\*.*", "R" {
        if (DateDiff(A_Now, FileGetTime(A_LoopFileFullPath, "C"), "Days") >= 4) {
            try {
                FileDelete(A_LoopFileFullPath)
                DeletedCount++
            }
        }
    }
    MsgBox("Очистка завершена! Удалено старых откатов: " DeletedCount " шт.", "Инфо", "Iconi T3")
}

Home:: {
    static RulesGui := 0
    if IsObject(RulesGui) && WinExist("ahk_id " RulesGui.Hwnd) {
        if DllCall("IsWindowVisible", "Ptr", RulesGui.Hwnd)
            RulesGui.Hide()
        else
            RulesGui.Show()
        return
    }
    RulesGui := Gui("+AlwaysOnTop -Caption +ToolWindow", "Правила RMRP")
    RulesGui.SetFont("s10 cBlack", "Consolas")
    RulesGui.BackColor := "Black"
    BtnPP    := RulesGui.Add("Button", "x10 y10 w80 h30", "ПП")
    BtnPGO   := RulesGui.Add("Button", "x100 y10 w80 h30", "ПГО")
    BtnPKO   := RulesGui.Add("Button", "x190 y10 w80 h30", "ПКО")
    BtnFKZ   := RulesGui.Add("Button", "x280 y10 w80 h30", "ФКЗ")
    BtnClose := RulesGui.Add("Button", "x700 y10 w100 h30", "Закрыть")
    EditCtrl := RulesGui.Add("Edit", "x10 y50 w800 h500 ReadOnly +Multi +Wrap +VScroll", pp_text)
    BtnPP.OnEvent("Click",    (*) => EditCtrl.Value := pp_text)
    BtnPGO.OnEvent("Click",   (*) => EditCtrl.Value := pgo_text)
    BtnPKO.OnEvent("Click",   (*) => EditCtrl.Value := pko_text)
    BtnFKZ.OnEvent("Click",   (*) => EditCtrl.Value := fkz_text)
    BtnClose.OnEvent("Click", (*) => RulesGui.Hide())
    RulesGui.Show("x5 y50 NoActivate")
}

!w:: {
    global WarningsMap
    WGui := Gui("+AlwaysOnTop +ToolWindow", "Управление игроком")
    WGui.SetFont("s10", "Segoe UI")
    WGui.Add("Text",, "Введите 6 цифр ID:")
    EdID := WGui.Add("Edit", "w250 Limit6", "")
    WGui.Add("Text",, "Причина (для предов и киков):")
    EdReason := WGui.Add("Edit", "w250", "Помеха съемке")

    ProcessPlayer(Type) {
        RawID  := EdID.Value
        Reason := EdReason.Value
        if !(RawID ~= "^\d{6}$")
            return MsgBox("ID должен состоять строго из 6 цифр!", "Ошибка")
        if (Reason == "" && Type != 4)
            return MsgBox("Заполните причину!", "Ошибка")
        WGui.Destroy()
        FID := SubStr(RawID, 1, 3) "-" SubStr(RawID, 4, 3)
        if (Type == 1) {
            WarningsMap[RawID] := WarningsMap.Has(RawID) ? WarningsMap[RawID] + 1 : 1
            ManageWarnLV(1, FID, WarningsMap[RawID], Reason)
            TXT := "/sms " FID " Здравствуйте! Являюсь медиа Вадим Лопатин, выдвигаю вам предупреждение! По причине: " Reason "! После 3 предупреждения будете автоматически кикнуты из деменшена за помеху съемке."
            SetTimer(() => SendGameCmd(TXT), -200)
        } else if (Type == 2) {
            if WarningsMap.Has(RawID)
                WarningsMap.Delete(RawID)
            ManageWarnLV(2, FID)
            SetTimer(() => SendGameCmd("/dimkick " FID " " Reason), -200)
        } else if (Type == 3) {
            SetTimer(() => SendGameCmd("/diminvite " FID " " Reason), -200)
        } else if (Type == 4) {
            OpenPedsMenu(FID)
        }
    }

    WGui.Add("Button", "w250 y+15", "Выдать ПРЕДУПРЕЖДЕНИЕ (+ СМС)").OnEvent("Click", (*) => ProcessPlayer(1))
    WGui.Add("Button", "w250", "Мгновенный КИК (/dimkick)").OnEvent("Click", (*) => ProcessPlayer(2))
    WGui.Add("Button", "w250", "Пригласить в мир (/diminvite)").OnEvent("Click", (*) => ProcessPlayer(3))
    WGui.Add("Button", "w250", "Выдать ПРОВЕРЕННЫЙ СКИН").OnEvent("Click", (*) => ProcessPlayer(4))
    WGui.Show()
}

F2:: SendGameCmd("/mediadimension")
!c:: SendGameCmd("/clearvehicles")

F11:: {
    global WarnGui, IsWarnGuiVisible
    IsWarnGuiVisible := !IsWarnGuiVisible
    if IsWarnGuiVisible
        WarnGui.Show("x" (A_ScreenWidth - 460) " y100")
    else
        WarnGui.Hide()
}

F12:: {
    global WarningsMap
    WarningsMap := Map()
    WarnLV.Delete()
}

NumpadAdd:: {
    global ReportCount
    ReportCount++
    ShowQuickTip("Репортов: " ReportCount)
}

NumpadSub:: {
    global ReportCount
    if (ReportCount > 0)
        ReportCount--
    ShowQuickTip("Репортов: " ReportCount)
}

PgUp:: ShowQuickTip("Репортов: " ReportCount)

Delete:: {
    global ReportCount
    ReportCount := 0
    ShowQuickTip("Счётчик репортов сброшен")
}

PgDn:: Help_ShowHelpWindow()

F1:: {
    static MushGui := 0
    if IsObject(MushGui) && WinExist("ahk_id " MushGui.Hwnd) {
        MushGui.Destroy()
        return
    }
    MushGui := Gui("+AlwaysOnTop +ToolWindow", "Грибы RMRP")
    MushGui.SetFont("s10", "Segoe UI")
    LV := MushGui.Add("ListView", "r15 w350 Grid", ["Название", "Цена", "Шанс"])
    LV.ModifyCol(1, 200)
    LV.ModifyCol(2, 70)
    LV.ModifyCol(3, 60)
    for m in MushroomsList
        LV.Add(, m[1], m[2], m[3])
    MushGui.Show()
}

