#HotIf

; =============================================================================
; УТИЛИТЫ
; =============================================================================
IsNumber(val) {
    if val is Number
        return true
    if (Type(val) = "String" && RegExMatch(val, "^-?\d+(\.\d+)?$"))
        return true
    return false
}

CaptureScreenToFile(filePath) {
    if FileExist(filePath)
        FileDelete(filePath)

    hGdiplus := DllCall("LoadLibrary", "Str", "gdiplus.dll", "Ptr")
    if !hGdiplus
        return false

    si := Buffer(24, 0)
    NumPut("UInt", 1, si, 0)
    pToken := 0
    DllCall("gdiplus\GdiplusStartup", "Ptr*", &pToken, "Ptr", si, "Ptr", 0)

    w := SysGet(78), h := SysGet(79), x := SysGet(76), y := SysGet(77)
    hDC := DllCall("GetDC", "Ptr", 0, "Ptr")
    mDC := DllCall("CreateCompatibleDC", "Ptr", hDC, "Ptr")
    hBM := DllCall("CreateCompatibleBitmap", "Ptr", hDC, "Int", w, "Int", h, "Ptr")
    oBM := DllCall("SelectObject", "Ptr", mDC, "Ptr", hBM, "Ptr")
    DllCall("BitBlt", "Ptr", mDC, "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr", hDC, "Int", x, "Int", y, "UInt", 0x00CC0020)

    pBitmap := 0
    DllCall("gdiplus\GdipCreateBitmapFromHBITMAP", "Ptr", hBM, "Ptr", 0, "Ptr*", &pBitmap)

    clsid := Buffer(16)
    DllCall("ole32\CLSIDFromString", "WStr", "{557CF406-1A04-11D3-9A73-0000F81EF32E}", "Ptr", clsid)
    res := DllCall("gdiplus\GdipSaveImageToFile", "Ptr", pBitmap, "WStr", filePath, "Ptr", clsid, "Ptr", 0)

    DllCall("gdiplus\GdipDisposeImage", "Ptr", pBitmap)
    DllCall("SelectObject", "Ptr", mDC, "Ptr", oBM)
    DllCall("DeleteObject", "Ptr", hBM)
    DllCall("DeleteDC", "Ptr", mDC)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", hDC)
    DllCall("gdiplus\GdiplusShutdown", "Ptr", pToken)
    DllCall("FreeLibrary", "Ptr", hGdiplus)

    return (res == 0 && FileExist(filePath))
}
