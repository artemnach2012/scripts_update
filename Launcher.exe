SendGameCmd(Text) {
    if (WinActive("ahk_exe GTA5.exe") or WinActive("ahk_exe ragemp_v.exe")) {
        BlockInput(true)
        SendEvent("{t Down}")
        Sleep(40)
        SendEvent("{t Up}")
        Sleep(150)
        SendText(Text)
        Sleep(100)
        SendEvent("{Enter Down}")
        Sleep(40)
        SendEvent("{Enter Up}")
        BlockInput(false)
    }
}

ManageWarnLV(Mode, FID, Count := 0, Reason := "") {
    if (Mode == 1) {
        Row := 0
        Loop WarnLV.GetCount() {
            if (WarnLV.GetText(A_Index, 1) == FID)
                Row := A_Index
        }
        if (Row > 0)
            WarnLV.Modify(Row, , FID, Count " / 3", Reason)
        else
            WarnLV.Add(, FID, Count " / 3", Reason)
    } else if (Mode == 2) {
        Loop WarnLV.GetCount() {
            if (WarnLV.GetText(A_Index, 1) == FID)
                WarnLV.Delete(A_Index)
        }
    }
}

SendSkinToGame() {
    Global CurrentSkinIndex, TargetPlayerID
    if !(WinActive("ahk_exe GTA5.exe") or WinActive("ahk_exe ragemp_v.exe"))
        return
    CommandText := "/setmodel " TargetPlayerID " " PedsBase[CurrentSkinIndex]
    OldClipboard := ClipboardAll()
    A_Clipboard := CommandText
    ClipWait(1)
    BlockInput(true)
    SendEvent("^v")
    Sleep(80)
    SendEvent("{Enter}")
    BlockInput(false)
    A_Clipboard := OldClipboard
}

