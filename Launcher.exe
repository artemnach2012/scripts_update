}

btnStopAll := CreateFlatBtn(mainGui, 210, 432, 160, 32, "⏹ Остановить все", CLR_CARD, CLR_DANGER)
btnStopAll.OnEvent("Click", StopAllModules)
mainControls.Push(btnStopAll)

tabPages["Main"] := mainControls

BuildSettingsTabs()

mainGui.SetFont("s8 Norm c" CLR_MUTED)
statusBar := mainGui.Add("Text", "x385 y440 w310 Right BackgroundTrans", "Готов к работе • Режим без файлов")

SwitchTab("Main")
mainGui.Show("w720 h480")

; ==================== UI ВСПОМОГАТЕЛЬНЫЕ ====================
CreateFlatBtn(guiObj, x, y, w, h, text, bgColor, txtColor, align := "Center") {
    alignOpt := (align == "Left") ? "0x200" : "Center 0x200"
    guiObj.SetFont("s9 Bold c" txtColor)
    return guiObj.Add("Text", "x" x " y" y " w" w " h" h " " alignOpt " Background" bgColor, text)
}

SwitchTab(targetKey, *) {
    global activeTab
    activeTab := targetKey
    for k, btn in navButtons {
        if (k == targetKey) {
            btn.Opt("Background" CLR_ACCENT)
            btn.SetFont("c" CLR_TEXT)
        } else {
            btn.Opt("Background" CLR_SIDEBAR)
            btn.SetFont("c" CLR_MUTED)
        }
        btn.Redraw()
    }
    for pageKey, ctrls in tabPages {
        isVisible := (pageKey == targetKey)
        for ctrl in ctrls
            ctrl.Visible := isVisible
    }
}

BuildSettingsTabs() {
    global tabPages, mainGui, Cfg

    ; --- АРМИЯ ДОКЛАДОВ ---
    pArmy := []
    mainGui.SetFont("s14 Bold c" CLR_TEXT)
    pArmy.Push(mainGui.Add("Text", "x210 y18 w450 BackgroundTrans", "📢 Армия докладов"))
    pArmy.Push(mainGui.Add("Text", "x210 y65 w485 h180 Background" CLR_CARD))

    mainGui.SetFont("s10 Norm c" CLR_TEXT)
    pArmy.Push(mainGui.Add("Text", "x230 y85 w440 BackgroundTrans", "При нажатии «Запустить» открывается окно с генератором 5 докладов и таймером."))

    btnOpenArmy := CreateFlatBtn(mainGui, 230, 140, 220, 38, "📋 Открыть окно докладов", CLR_ACCENT, CLR_TEXT)
    btnOpenArmy.OnEvent("Click", (*) => ShowArmyReportsGui())
    pArmy.Push(btnOpenArmy)

    for c in pArmy
        c.Visible := false
    tabPages["ArmyReports"] := pArmy

    ; --- АНТИ-АФК ---
    pAFK := []
    mainGui.SetFont("s14 Bold c" CLR_TEXT)
    pAFK.Push(mainGui.Add("Text", "x210 y18 w450 BackgroundTrans", "🏃 Настройки: Анти-АФК"))
    pAFK.Push(mainGui.Add("Text", "x210 y65 w485 h210 Background" CLR_CARD))

    mainGui.SetFont("s10 Norm c" CLR_TEXT)
    pAFK.Push(mainGui.Add("Text", "x230 y85 BackgroundTrans", "Максимальный интервал между действиями (секунд):"))
    edtInt := mainGui.Add("Edit", "x230 y112 w100 -E0x200 Number Background" CLR_INPUT " c" CLR_TEXT, Cfg.AFK_Interval)
    edtInt.OnEvent("Change", (*) => (Cfg.AFK_Interval := Integer(edtInt.Value || 5)))
    pAFK.Push(edtInt)

    chkChat := mainGui.Add("CheckBox", "x230 y155 w440 c" CLR_TEXT " Background" CLR_CARD, "Отправлять пробел в чат вместо нажатий WASD")
    chkChat.OnEvent("Click", (*) => (Cfg.AFK_ChatMode := chkChat.Value))
    pAFK.Push(chkChat)

    mainGui.SetFont("s9 Norm c" CLR_MUTED)
    pAFK.Push(mainGui.Add("Text", "x230 y200 w440 BackgroundTrans", "Активация в игре: клавиша F8 (после запуска модуля на главной)."))

    for c in pAFK
        c.Visible := false
    tabPages["AntiAFK"] := pAFK

    ; --- МОСКВА-LIVE ---
    pML := []
    mainGui.SetFont("s14 Bold c" CLR_TEXT)
    pML.Push(mainGui.Add("Text", "x210 y18 w450 BackgroundTrans", "📺 Настройки: Москва-Live"))
    pML.Push(mainGui.Add("Text", "x210 y65 w485 h290 Background" CLR_CARD))

    mainGui.SetFont("s10 Norm c" CLR_TEXT)
    pML.Push(mainGui.Add("Text", "x230 y82 BackgroundTrans", "Задержка перед отправкой Enter после вставки (мс):"))
    edtDel := mainGui.Add("Edit", "x230 y108 w100 -E0x200 Number Background" CLR_INPUT " c" CLR_TEXT, Cfg.ML_PasteDelay)
    edtDel.OnEvent("Change", (*) => (Cfg.ML_PasteDelay := Integer(edtDel.Value || 100)))
    pML.Push(edtDel)

    mainGui.SetFont("s9 Norm c" CLR_MUTED)
    mlKeys := "
    (
    Горячие клавиши (работают при включенном модуле):
    • Ctrl + Alt + C — скопировать выделенный текст и разбить на абзацы
    • Ctrl + Alt + X — показать шпаргалку абзацев
    • Numpad 1–0 — вставить нужный абзац в чат и отправить
    • Numpad + — отправить «продолжаем редакт»
    • Numpad . (Точка) — отправить «стоп редакт!»
    • Ctrl + Alt + H — показать/скрыть справку
    )"
    pML.Push(mainGui.Add("Text", "x230 y150 w440 h185 BackgroundTrans", mlKeys))

    for c in pML
        c.Visible := false
    tabPages["MoscowLive"] := pML

    ; --- ХЕЛПЕРКА ---
    pHelp := []
    mainGui.SetFont("s14 Bold c" CLR_TEXT)
    pHelp.Push(mainGui.Add("Text", "x210 y18 w450 BackgroundTrans", "🛡️ Хелперка RMRP"))
    mainGui.SetFont("s9 Norm c" CLR_TEXT)
    pHelp.Push(mainGui.Add("Text", "x210 y65 w485 h330 Background" CLR_CARD))

    hotkeysHelp := "
    (
    • F8 — Скриншот слежки (папки Поставки / Налеты / Ограбления)
    • Home — База правил сервера (ПП, ПГО, ПКО, ФКЗ)
    • F1 — Шпаргалка по грибам (цены и шансы)
    • Alt + W — Управление игроком (преды, кик, инвайт, скины)
    • Alt + V — Гараж транспорта медиа-партнёра
    • F2 — Войти в медиа-измерение (/mediadimension)
    • Alt + C — Очистить транспорт (/clearvehicles)
    • F11 / F12 — Показать / Очистить таблицу предупреждений
    • Alt + ↑ / ← / → / ↓ — Внутриигровой тестер скинов
    • Numpad + / - / PgUp / Delete — Счётчик репортов (в памяти)
    • Page Down — Показать шпаргалку горячих клавиш
    • Ctrl+Alt+C — Очистка папки NVIDIA (старше 4 дней)
    )"
    pHelp.Push(mainGui.Add("Text", "x225 y80 w455 h265 BackgroundTrans", hotkeysHelp))
    mainGui.SetFont("s8 Norm c" CLR_WARNING)
    pHelp.Push(mainGui.Add("Text", "x225 y355 w455 BackgroundTrans", "Создаются только папки Поставки / Налеты / Ограбления на Рабочем столе."))
    for c in pHelp
        c.Visible := false
    tabPages["Helpers"] := pHelp
}

; ==================== ВКЛЮЧЕНИЕ / ВЫКЛЮЧЕНИЕ МОДУЛЕЙ ====================
ToggleModule(key, *) {
    global ScriptState, guiControls
    newState := !ScriptState[key]
    ScriptState[key] := newState
    ctrl := guiControls[key]

    if newState {
        ctrl.stripe.Opt("Background" CLR_SUCCESS)
        ctrl.statusTxt.Value := "● Активен"
        ctrl.statusTxt.SetFont("c" CLR_SUCCESS)
        ctrl.btnToggle.Value := "⏹ Остановить"
        ctrl.btnToggle.Opt("Background" CLR_DANGER)
        statusBar.Value := "▶ Запущен модуль: " key

        if (key == "ArmyReports")
            ShowArmyReportsGui()
        else if (key == "MoscowLive")
            ML_ShowHelpInfo()
        else if (key == "Helpers") {
            InitHelpersFolders()
            Help_ShowHelpWindow()
        }
    } else {
        ctrl.stripe.Opt("Background" CLR_BORDER)
        ctrl.statusTxt.Value := "● Отключен"
        ctrl.statusTxt.SetFont("c" CLR_MUTED)
        ctrl.btnToggle.Value := "▶ Запустить"
        ctrl.btnToggle.Opt("Background" CLR_SUCCESS)
        statusBar.Value := "⏹ Остановлен модуль: " key

        if (key == "AntiAFK") {
            global AFK_Toggle
            AFK_Toggle := false
            SetTimer(RandomPress, 0)
            ToolTip()
        } else if (key == "MoscowLive") {
            ML_CloseAll()
        }
    }
    ctrl.stripe.Redraw()
    ctrl.btnToggle.Redraw()
}

StopAllModules(*) {
    for key, state in ScriptState {
        if state
            ToggleModule(key)
    }
    statusBar.Value := "⏹ Все модули остановлены"
}

; ==================== АВТООБНОВЛЕНИЕ ====================
CheckLauncherUpdate(*) {
    statusBar.Value := "Проверка обновлений на GitHub..."
    try {
        whr := ComObject("WinHttp.WinHttpRequest.5.1")
        whr.Open("GET", RAW_BASE "versions.json?t=" A_TickCount, false)
        whr.Send()
        if (whr.Status == 200 && RegExMatch(whr.ResponseText, '"Launcher"\s*:\s*"([^"]+)"', &m)) {
            remVer := m[1]
            if (remVer == "2.0.1") {
                MsgBox("У вас установлена последняя версия (2.0.1)!", "Обновление", "Iconi")
                statusBar.Value := "✅ Актуальная версия"
                return
            }
            if !A_IsCompiled {
                MsgBox("Доступна версия " remVer ". Скомпилируйте скрипт в EXE для автообновления.", "Инфо", "Iconi")
                return
            }
            if MsgBox("Доступна новая версия лаунчера (" remVer "). Обновить сейчас?", "Обновление", "YesNo Icon?") == "Yes" {
                newExe  := A_Temp "\Launcher_upd.exe"
                batFile := A_Temp "\upd_launcher.bat"
                Download(RAW_BASE "Launcher.exe?t=" A_TickCount, newExe)
                bat := '@echo off' "`r`n"
                     . 'timeout /t 2 /nobreak >nul' "`r`n"
                     . 'move /y "' newExe '" "' A_ScriptFullPath '"' "`r`n"
                     . 'start "" "' A_ScriptFullPath '"' "`r`n"
                     . 'del "%~f0"'
                if FileExist(batFile)
                    FileDelete(batFile)
                FileAppend(bat, batFile, "CP866")
                Run('"' batFile '"', , "Hide")
                ExitApp()
            }
        }
    } catch {
        MsgBox("Не удалось проверить обновления. Проверьте интернет.", "Ошибка", "IconX")
    }
    statusBar.Value := "Готов к работе"
}

; =============================================================================
; МОДУЛЬ 1: АНТИ-АФК
; =============================================================================
Global AFK_Toggle := false

#HotIf ScriptState["AntiAFK"]
F8:: {
    global AFK_Toggle
    AFK_Toggle := !AFK_Toggle
    if AFK_Toggle {
        ToolTip("Random WASD: ВКЛ", 100, 100)
        SetTimer(RandomPress, -1)
    } else {
        ToolTip("Random WASD: ВЫКЛ", 100, 100)
        SetTimer(RandomPress, 0)
        Sleep(1000)
        ToolTip()
    }
}
#HotIf

RandomPress() {
    global AFK_Toggle, Cfg, ScriptState
    if !AFK_Toggle || !ScriptState["AntiAFK"]
        return
    maxMs := Max(1500, Cfg.AFK_Interval * 1000)
    nextDelay := Random(200, maxMs)
    if Cfg.AFK_ChatMode {
        Send("{t}")
        Sleep(100)
        Send("{Space}{Enter}")
    } else {
        r := Random(1, 4)
        key := (r = 1) ? "w" : (r = 2) ? "a" : (r = 3) ? "s" : "d"
        holdTime := Random(50, 400)
        Send("{" key " down}")
        Sleep(holdTime)
        Send("{" key " up}")
    }
    if AFK_Toggle && ScriptState["AntiAFK"]
        SetTimer(RandomPress, -nextDelay)
}

; =============================================================================
; МОДУЛЬ 2: АРМИЯ ДОКЛАДОВ
; =============================================================================
ShowArmyReportsGui() {
    static ArmyGui := 0
    if IsObject(ArmyGui) && WinExist("ahk_id " ArmyGui.Hwnd) {
        ArmyGui.Show()
        return
    }

    reports         := []
    currentIndex    := 1
    intervalMinutes := 1.0
    timerRunning    := false
    remainingMs     := 0

    ArmyGui := Gui("+AlwaysOnTop", "Армия докладов")
    ArmyGui.BackColor := "2A2A2A"
    ArmyGui.SetFont("s14 cYellow Bold", "Segoe UI")
    ArmyGui.Add("Text", "xm w400 Center", "📢 АРМИЯ ДОКЛАДОВ")

    ArmyGui.SetFont("s10 cWhite", "Segoe UI")
    ArmyGui.Add("Text", "xm y+20", "Звание:")
    ArmyGui.SetFont("s10 cBlack", "Segoe UI")
    edtRank := ArmyGui.Add("Edit", "w200 xm y+5", "")

    ArmyGui.SetFont("s10 cWhite", "Segoe UI")
    ArmyGui.Add("Text", "xm y+15", "Фамилия:")
    ArmyGui.SetFont("s10 cBlack", "Segoe UI")
    edtSurname := ArmyGui.Add("Edit", "w200 xm y+5", "")

    ArmyGui.SetFont("s10 cWhite", "Segoe UI")
    ArmyGui.Add("Text", "xm y+15", "Пост:")
    ArmyGui.SetFont("s10 cBlack", "Segoe UI")
    edtPost := ArmyGui.Add("Edit", "w200 xm y+5", "КПП-1")

    ArmyGui.SetFont("s10 cWhite", "Segoe UI")
    ArmyGui.Add("Text", "xm y+15", "Интервал (минуты):")
    ArmyGui.SetFont("s10 cBlack", "Segoe UI")
    edtInterval := ArmyGui.Add("Edit", "w80 xm y+5", "10")

    ArmyGui.SetFont("s10 cBlack Bold", "Segoe UI")
    btnStart   := ArmyGui.Add("Button", "xm y+20 w100", "▶ Старт")
    btnStart.BackColor := "4CAF50"
    btnStop    := ArmyGui.Add("Button", "x+10 w100 Disabled", "⏹ Стоп")
    btnStop.BackColor  := "F44336"
    btnConfirm := ArmyGui.Add("Button", "x+10 w120 Hidden", "✅ Отправил")
    btnConfirm.BackColor := "2196F3"

    ArmyGui.SetFont("s28 cLime Bold", "Segoe UI")
    txtTimer := ArmyGui.Add("Text", "xm y+20 w400 Center", "⏳ 00:00.00")
    ArmyGui.SetFont("s10 cWhite", "Segoe UI")
    txtStatus := ArmyGui.Add("Text", "xm y+15 w400 Center", "Готов к работе.")

    UpdateArmyTimer() {
        if !timerRunning {
            SetTimer(UpdateArmyTimer, 0)
            return
        }
        remainingMs -= 50
        if (remainingMs <= 0) {
            timerRunning := false
            SetTimer(UpdateArmyTimer, 0)
            txtTimer.Value := "⏳ 00:00.00"
            currentIndex += 1
            A_Clipboard := reports[currentIndex]
            SoundBeep(1000, 300)
            ToolTip("🔔 Доклад №" currentIndex " скопирован в буфер!")
            SetTimer(() => ToolTip(), -3000)
            txtStatus.Value := "📋 Доклад №" currentIndex " скопирован. Отправьте и нажмите 'Отправил'."
            btnConfirm.Enabled := true
            btnConfirm.Text := (currentIndex >= reports.Length) ? "🏁 Завершить" : "✅ Отправил"
            return
        }
        totalSec := remainingMs / 1000
        txtTimer.Value := "⏳ " Format("{:02}:{:02}.{:02}",
            Floor(totalSec / 60), Floor(Mod(totalSec, 60)), Floor(Mod(totalSec * 100, 100)))
    }

    btnStart.OnEvent("Click", (*) => (
        (edtRank.Value == "" || edtSurname.Value == "" || edtPost.Value == "")
            ? MsgBox("Заполните все поля!", "Ошибка", "Icon!")
            : (
                intervalMinutes := edtInterval.Value + 0.0,
                (!IsNumber(intervalMinutes) || intervalMinutes <= 0)
                    ? MsgBox("Интервал должен быть положительным числом!", "Ошибка", "Icon!")
                    : (
                        reports := [
                            "Докладывает: " edtRank.Value " " edtSurname.Value " | Заступил на пост: " edtPost.Value " | Состав: 1 | Пост принял | Доклад окончен.",
                            "Докладывает: " edtRank.Value " " edtSurname.Value " | Пост: " edtPost.Value " | Состав: 1 | " (intervalMinutes * 1) " мин | Состояние: стабильное | Доклад окончен.",
                            "Докладывает: " edtRank.Value " " edtSurname.Value " | Пост: " edtPost.Value " | Состав: 1 | " (intervalMinutes * 2) " мин | Состояние: стабильное | Доклад окончен.",
                            "Докладывает: " edtRank.Value " " edtSurname.Value " | Пост: " edtPost.Value " | Состав: 1 | " (intervalMinutes * 3) " мин | Состояние: стабильное | Доклад окончен.",
                            "Докладывает: " edtRank.Value " " edtSurname.Value " | Пост: " edtPost.Value " | Состав: 1 | Состояние стабильное | Пост сдал | Доклад окончен."
                        ],
                        currentIndex := 1,
                        timerRunning := false,
                        SetTimer(UpdateArmyTimer, 0),
                        txtTimer.Value := "⏳ 00:00.00",
                        A_Clipboard := reports[1],
                        txtStatus.Value := "📋 Доклад №1 скопирован. Отправьте и нажмите 'Отправил'.",
                        btnStart.Enabled := false,
                        btnStop.Enabled  := true,
                        btnConfirm.Visible  := true,
                        btnConfirm.Enabled  := true,
                        btnConfirm.Text := "✅ Отправил"
                    )
            )
    ))

    btnConfirm.OnEvent("Click", (*) => (
        timerRunning ? 0 : (
            currentIndex >= reports.Length
                ? (
                    timerRunning := false,
                    SetTimer(UpdateArmyTimer, 0),
                    txtTimer.Value := "⏳ 00:00.00",
                    txtStatus.Value := "🏁 Все доклады отправлены! Работа завершена.",
                    btnConfirm.Visible := false,
                    btnStart.Enabled := true,
                    btnStop.Enabled  := false,
                    SoundBeep(1500, 300),
                    ToolTip("✅ Все доклады отправлены!"),
                    SetTimer(() => ToolTip(), -3000)
                )
                : (
                    timerRunning := true,
                    remainingMs  := intervalMinutes * 60 * 1000,
                    btnConfirm.Enabled := false,
                    btnConfirm.Text := "⏳ Ожидание...",
                    txtStatus.Value := "⏳ Следующий доклад через " intervalMinutes " мин.",
                    SetTimer(UpdateArmyTimer, 50)
                )
        )
    ))

    btnStop.OnEvent("Click", (*) => (
        timerRunning := false,
        SetTimer(UpdateArmyTimer, 0),
        txtTimer.Value := "⏳ 00:00.00",
        btnStart.Enabled := true,
        btnStop.Enabled  := false,
        btnConfirm.Visible := false,
        btnConfirm.Enabled := false,
        txtStatus.Value := "⏹ Остановлено.",
        currentIndex := 1
    ))

    ArmyGui.OnEvent("Close", (*) => (timerRunning := false, SetTimer(UpdateArmyTimer, 0), ArmyGui.Destroy()))
    ArmyGui.Show()
}

; =============================================================================
; МОДУЛЬ 3: МОСКВА-LIVE
; =============================================================================
Global ML_Paragraphs := []
Global ML_InfoGui    := ""
Global ML_HelpGui    := ""

ML_IsHoroscope(text) {
    if RegExMatch(text, "♈|♉|♊|♋|♌|♍|♎|♏|♐|♑|♒|♓")
        return true
    if RegExMatch(text, "Овен|Телец|Близнецы|Рак|Лев|Дева|Весы|Скорпион|Стрелец|Козерог|Водолей|Рыбы")
        return true
    return false
}

ML_GroupByTwo(arr) {
    grouped := []
    loop arr.Length {
        if (Mod(A_Index, 2) = 1) {
            if (A_Index = arr.Length)
                grouped.Push(arr[A_Index])
            else
                grouped.Push(arr[A_Index] . "`n`n" . arr[A_Index + 1])
        }
    }
    return grouped
}

ML_SplitByQuestions(text) {
    blocks := []
    pos := 1
    while (pos <= StrLen(text)) {
        if (RegExMatch(text, "Вопрос\s+\d+:", &match, pos)) {
            startQ := match.Pos
            endQ   := startQ + match.Len - 1
            nextPos := RegExMatch(text, "Вопрос\s+\d+:", , endQ + 1)
            if (nextPos = 0)
                nextPos := StrLen(text) + 1
            questionBlock := Trim(RegExReplace(
                StrReplace(StrReplace(SubStr(text, startQ, nextPos - startQ), "`r`n", " "), "`n", " "),
                " {2,}", " "))
            if (questionBlock != "")
                blocks.Push(questionBlock)
            pos := nextPos
        } else {
            break
        }
    }
    return blocks
}

ML_ShowHelpWindow() {
    global ML_Paragraphs, ML_InfoGui
    if (ML_InfoGui != "")
        ML_InfoGui.Destroy()
    if (ML_Paragraphs.Length == 0)
        return

    ML_InfoGui := Gui("+AlwaysOnTop -Caption +ToolWindow")
    ML_InfoGui.BackColor := "1F1F1F"
    ML_InfoGui.SetFont("s10 cYellow Bold", "Segoe UI")
    ML_InfoGui.Add("Text", "w380 Center", "📋 ШПАРГАЛКА NUMPAD:")

    maxCount := (ML_Paragraphs.Length > 10) ? 10 : ML_Paragraphs.Length
    Loop maxCount {
        preview := SubStr(ML_Paragraphs[A_Index], 1, 60)
        if (StrLen(ML_Paragraphs[A_Index]) > 60)
            preview .= "..."
        keyName := (A_Index == 10) ? "Numpad0" : "Numpad" A_Index
        ML_InfoGui.SetFont("s9 cYellow Bold", "Segoe UI")
        ML_InfoGui.Add("Text", "w70 x15 y+8", keyName)
        ML_InfoGui.SetFont("s9 cWhite", "Segoe UI")
        ML_InfoGui.Add("Text", "w290 x+5 yp", "➔  " preview)
    }

    ML_InfoGui.SetFont("s9 cGray Bold", "Segoe UI")
    ML_InfoGui.Add("Text", "w350 x15 y+12 Center", "─────────────────────────────────")
    ML_InfoGui.SetFont("s9 cYellow Bold", "Segoe UI")
    ML_InfoGui.Add("Text", "w70 x15 y+8", "Numpad +")
    ML_InfoGui.SetFont("s9 c00FF66 Bold", "Segoe UI")
    ML_InfoGui.Add("Text", "w290 x+5 yp", "➔  продолжаем редакт")
    ML_InfoGui.SetFont("s9 cYellow Bold", "Segoe UI")
    ML_InfoGui.Add("Text", "w70 x15 y+8", "Numpad .")
    ML_InfoGui.SetFont("s9 cFF5555 Bold", "Segoe UI")
    ML_InfoGui.Add("Text", "w290 x+5 yp", "➔  стоп редакт!")

    ML_InfoGui.Show("x" (A_ScreenWidth - 500) " y250 NoActivate")
    WinSetTransparent(220, ML_InfoGui)
}

ML_ShowHelpInfo() {
    global ML_HelpGui
    if (ML_HelpGui != "") {
        ML_HelpGui.Destroy()
        ML_HelpGui := ""
    }
    ML_HelpGui := Gui("+AlwaysOnTop -Caption +ToolWindow")
    ML_HelpGui.BackColor := "2A2A2A"
    ML_HelpGui.SetFont("s10 cWhite", "Segoe UI")
    ML_HelpGui.Add("Text", "w420 Center", "🚀 Скрипт Москва-Live активен!")
    ML_HelpGui.SetFont("s9 cYellow", "Segoe UI")
    ML_HelpGui.Add("Text", "w420 y+10 Center", "Горячие клавиши:")
    ML_HelpGui.SetFont("s9 cWhite", "Segoe UI")
    ML_HelpGui.Add("Text", "w420 y+5", "  Ctrl+Alt+C  – скопировать выделенное и разбить на абзацы")
    ML_HelpGui.Add("Text", "w420",     "  Ctrl+Alt+X  – показать шпаргалку (после Ctrl+Alt+C)")
    ML_HelpGui.Add("Text", "w420",     "  Numpad1-0   – вставить соответствующий абзац")
    ML_HelpGui.Add("Text", "w420",     "  Numpad+     – вставить «продолжаем редакт»")
    ML_HelpGui.Add("Text", "w420",     "  Numpad.     – вставить «стоп редакт!»")
    ML_HelpGui.Add("Text", "w420",     "  Esc         – закрыть активное окно (шпаргалку или справку)")
    ML_HelpGui.SetFont("s9 cGray", "Segoe UI")
    ML_HelpGui.Add("Text", "w420", "Для повторного открытия этой справки: Ctrl+Alt+H")
    ML_HelpGui.SetFont("s8 cSilver", "Segoe UI")
    ML_HelpGui.Add("Text", "w420 y+10 Center", "(окно автоматически закроется через 15 секунд)")
    ML_HelpGui.Show("x" (A_ScreenWidth - 450) " y150 NoActivate")
    WinSetTransparent(230, ML_HelpGui)
    SetTimer(ML_CloseHelpInfo, -15000)
}

ML_CloseHelpInfo() {
    global ML_HelpGui
    if (ML_HelpGui != "") {
        ML_HelpGui.Destroy()
        ML_HelpGui := ""
    }
}

ML_CloseAll() {
    global ML_InfoGui
    if (ML_InfoGui != "") {
        ML_InfoGui.Destroy()
        ML_InfoGui := ""
    }
    ML_CloseHelpInfo()
}

ML_SendParagraph(index) {
    global ML_Paragraphs, Cfg
    if (index <= ML_Paragraphs.Length) {
        oldClip := ClipboardAll()
        A_Clipboard := ML_Paragraphs[index]
        Send("^v")
        Sleep(Cfg.ML_PasteDelay)
        Send("{Enter}")
        Sleep(50)
        A_Clipboard := oldClip
    }
}

ML_SendCustomText(textToText) {
    global Cfg
    oldClip := ClipboardAll()
    A_Clipboard := textToText
    Send("^v")
    Sleep(Cfg.ML_PasteDelay)
    Send("{Enter}")
    Sleep(50)
    A_Clipboard := oldClip
}

#HotIf ScriptState["MoscowLive"]
^!c:: {
    global ML_Paragraphs
    ML_Paragraphs := []
    oldClip := ClipboardAll()
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        ToolTip("Ошибка: не удалось скопировать текст")
        SetTimer(() => ToolTip(), -2000)
        A_Clipboard := oldClip
        return
    }
    rawText := StrReplace(A_Clipboard, "`r`n", "`n")
    cleanLines := ""
    Loop Parse, rawText, "`n" {
        cleanLines .= Trim(A_LoopField, " `t`r") "`n"
    }
    cleanLines := Trim(RegExReplace(cleanLines, "\n{3,}", "`n`n"), "`n")

    if RegExMatch(cleanLines, "Вопрос\s+\d+:", &m) {
        ML_Paragraphs := ML_SplitByQuestions(cleanLines)
    } else if ML_IsHoroscope(cleanLines) {
        rawBlocks := StrSplit(cleanLines, "`n`n")
        tempBlocks := []
        for block in rawBlocks {
            cleanBlock := RegExReplace(Trim(StrReplace(block, "`n", " ")), " {2,}", " ")
            if (cleanBlock != "")
                tempBlocks.Push(cleanBlock)
        }
        ML_Paragraphs := ML_GroupByTwo(tempBlocks)
    } else {
        rawBlocks := StrSplit(cleanLines, "`n`n")
        for _, block in rawBlocks {
            cleanBlock := Trim(RegExReplace(StrReplace(block, "`n", " "), " {2,}", " "))
            if (cleanBlock != "")
                ML_Paragraphs.Push(cleanBlock)
        }
        if (ML_Paragraphs.Length > 1) {
            lastIndex := ML_Paragraphs.Length
            lastBlock := ML_Paragraphs[lastIndex]
            if (RegExMatch(cleanLines, "`n([^`n]+)$", &lastLineMatch)) {
                lastLineText := Trim(lastLineMatch[1])
                if (InStr(lastBlock, lastLineText) && lastBlock != lastLineText) {
                    ML_Paragraphs[lastIndex] := Trim(StrReplace(lastBlock, lastLineText, ""))
                    ML_Paragraphs.Push(lastLineText)
                }
            }
        }
    }
    A_Clipboard := oldClip
    ML_ShowHelpWindow()
}

$Numpad1:: ML_SendParagraph(1)
$Numpad2:: ML_SendParagraph(2)
$Numpad3:: ML_SendParagraph(3)
$Numpad4:: ML_SendParagraph(4)
$Numpad5:: ML_SendParagraph(5)
$Numpad6:: ML_SendParagraph(6)
$Numpad7:: ML_SendParagraph(7)
$Numpad8:: ML_SendParagraph(8)
$Numpad9:: ML_SendParagraph(9)
$Numpad0:: ML_SendParagraph(10)
$NumpadDot:: ML_SendCustomText("стоп редакт!")
$NumpadAdd:: ML_SendCustomText("продолжаем редакт")

^!x:: {
    global ML_Paragraphs
    if (ML_Paragraphs.Length > 0)
        ML_ShowHelpWindow()
    else {
        ToolTip("Буфер пуст! Сначала скопируйте текст через Ctrl+Alt+C")
        SetTimer(() => ToolTip(), -2000)
    }
}

^!h:: {
    global ML_HelpGui
    if (ML_HelpGui != "") {
        ML_HelpGui.Destroy()
        ML_HelpGui := ""
    } else {
        ML_ShowHelpInfo()
    }
}

~Esc:: ML_CloseAll()
