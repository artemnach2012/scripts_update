#Requires AutoHotkey v2.0
#SingleInstance Force
#MaxThreadsPerHotkey 3

; @version 2.0.1

GITHUB_REPO := "artemnach2012/scripts_update"
RAW_BASE    := "https://raw.githubusercontent.com/" GITHUB_REPO "/main/"

; ==================== СОСТОЯНИЯ МОДУЛЕЙ И НАСТРОЙКИ ====================
ScriptState := Map(
    "ArmyReports", false,
    "AntiAFK",     false,
    "MoscowLive",  false,
    "Helpers",     false
)

Cfg := {
    Army_AutoOpen: false,
    AFK_Interval:  30,
    AFK_ChatMode:  false,
    ML_PasteDelay: 100
}

; ==================== ПАЛИТРА ====================
CLR_BG       := "0F1117"
CLR_SIDEBAR  := "161922"
CLR_CARD     := "1C202B"
CLR_INPUT    := "12141C"
CLR_BORDER   := "2A3040"
CLR_TEXT     := "F8FAFC"
CLR_MUTED    := "94A3B8"
CLR_ACCENT   := "3B82F6"
CLR_SUCCESS  := "10B981"
CLR_DANGER   := "EF4444"
CLR_WARNING  := "F59E0B"

; ==================== ГЛАВНОЕ ОКНО ====================
mainGui := Gui("-Caption +Border", "RMRP Script Hub")
mainGui.BackColor := CLR_BG
mainGui.SetFont("s10 c" CLR_TEXT, "Segoe UI")

try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", mainGui.Hwnd, "Int", 33, "Int*", 2, "Int", 4)

mainGui.Add("Text", "x0 y0 w185 h480 Background" CLR_SIDEBAR)
mainGui.Add("Text", "x185 y0 w1 h480 Background" CLR_BORDER)

headerDrag := mainGui.Add("Text", "x0 y0 w720 h48 BackgroundTrans", "")
headerDrag.OnEvent("Click", (*) => PostMessage(0xA1, 2,,, mainGui))

mainGui.SetFont("s12 Bold c" CLR_TEXT)
mainGui.Add("Text", "x20 y16 w150 BackgroundTrans", "⚡ SCRIPT HUB")
mainGui.SetFont("s8 Bold c" CLR_ACCENT)
mainGui.Add("Text", "x20 y38 w150 BackgroundTrans", "ALL-IN-ONE • NO FILES")

btnMin := CreateFlatBtn(mainGui, 635, 10, 34, 28, "—", CLR_BG, CLR_MUTED)
btnMin.OnEvent("Click", (*) => mainGui.Minimize())

btnClose := CreateFlatBtn(mainGui, 674, 10, 36, 28, "✕", CLR_BG, CLR_MUTED)
