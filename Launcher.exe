; ==================== НАВИГАЦИЯ ====================
navButtons := Map()
tabPages   := Map()
activeTab  := "Main"

navItems := [
    { key: "Main",        icon: "🏠", label: "Главная панель", y: 75 },
    { key: "ArmyReports", icon: "📢", label: "Армия докладов",  y: 120 },
    { key: "AntiAFK",     icon: "🏃", label: "Анти-АФК",        y: 162 },
    { key: "MoscowLive",  icon: "📺", label: "Москва-Live",     y: 204 },
    { key: "Helpers",     icon: "🛡️", label: "Хелперка",        y: 246 }
]

for item in navItems {
    btn := CreateFlatBtn(mainGui, 12, item.y, 160, 36, "  " item.icon "  " item.label, CLR_SIDEBAR, CLR_MUTED, "Left")
    btn.OnEvent("Click", SwitchTab.Bind(item.key))
    navButtons[item.key] := btn
}

mainGui.Add("Text", "x15 y415 w155 h1 Background" CLR_BORDER)
mainGui.SetFont("s8 Norm c" CLR_MUTED)
mainGui.Add("Text", "x20 y425 w150 BackgroundTrans", "Версия ядра: v2.0.1")
btnCheckUpd := CreateFlatBtn(mainGui, 15, 444, 155, 26, "↻ Проверить обн.", CLR_CARD, CLR_ACCENT)
btnCheckUpd.OnEvent("Click", CheckLauncherUpdate)

; ==================== ВКЛАДКА 1: ГЛАВНАЯ ====================
mainControls := []

mainGui.SetFont("s14 Bold c" CLR_TEXT)
mainControls.Push(mainGui.Add("Text", "x210 y18 w400 BackgroundTrans", "Управление модулями"))
mainGui.SetFont("s9 Norm c" CLR_MUTED)
mainControls.Push(mainGui.Add("Text", "x210 y44 w480 BackgroundTrans", "Все скрипты вшиты внутрь EXE. Никакие сторонние файлы не создаются."))

modulesMeta := [
    { key: "ArmyReports", title: "Армия докладов", desc: "Генератор докладов на посту с таймером (v1.2.0)" },
    { key: "AntiAFK",     title: "Анти-АФК",       desc: "Случайные нажатия WASD или чат по F8 (v2.0.0)" },
    { key: "MoscowLive",  title: "Москва-Live",    desc: "Разбивка текста эфиров/вопросов на Numpad (v1.2.0)" },
    { key: "Helpers",     title: "Хелперка RMRP",  desc: "Правила, грибы, гараж, преды, слежка (v1.0.4)" }
]

guiControls := Map()
yPos := 80

for item in modulesMeta {
    card := mainGui.Add("Text", "x210 y" yPos " w485 h74 Background" CLR_CARD)
    mainControls.Push(card)

    stripe := mainGui.Add("Text", "x210 y" yPos " w4 h74 Background" CLR_BORDER)
    mainControls.Push(stripe)

    mainGui.SetFont("s11 Bold c" CLR_TEXT)
    mainControls.Push(mainGui.Add("Text", "x228 y" (yPos + 12) " w240 BackgroundTrans", item.title))

    mainGui.SetFont("s8 Norm c" CLR_MUTED)
    mainControls.Push(mainGui.Add("Text", "x228 y" (yPos + 34) " w320 BackgroundTrans", item.desc))

    mainGui.SetFont("s8 Bold c" CLR_MUTED)
    statusTxt := mainGui.Add("Text", "x228 y" (yPos + 52) " w150 BackgroundTrans", "● Отключен")
    mainControls.Push(statusTxt)

    btnToggle := CreateFlatBtn(mainGui, 575, yPos + 20, 105, 34, "▶ Запустить", CLR_SUCCESS, CLR_TEXT)
    btnToggle.OnEvent("Click", ToggleModule.Bind(item.key))
    mainControls.Push(btnToggle)

    guiControls[item.key] := { stripe: stripe, statusTxt: statusTxt, btnToggle: btnToggle }
